# Compose publishes the single-origin application on loopback only. Change the
# host port here if it conflicts locally; do not bind it to 0.0.0.0 casually.
OMNIFETCH_API_PORT=8000

# Local, ephemeral Phase-1 policy defaults.
OMNIFETCH_MAX_FILESIZE_MB=1024
OMNIFETCH_MAX_DURATION_MIN=120
OMNIFETCH_MAX_CONCURRENT_JOBS=2
OMNIFETCH_MAX_QUEUED_JOBS=8
OMNIFETCH_JOB_TIMEOUT_SECONDS=1800
OMNIFETCH_JOB_TTL_HOURS=6
OMNIFETCH_CLEANUP_INTERVAL_SECONDS=600
OMNIFETCH_MAX_BODY_BYTES=8192
OMNIFETCH_MAX_URL_LENGTH=4096
OMNIFETCH_SOCKET_TIMEOUT_SECONDS=15
OMNIFETCH_TERMINATE_GRACE_SECONDS=3
OMNIFETCH_MAX_WORKER_EVENT_BYTES=262144
OMNIFETCH_MAX_COOKIE_FILE_BYTES=1048576

# Public mode narrows URLs to known platform domains when Generic extraction is
# disabled. It does not add authentication, TLS, rate limits, or egress policy.
# Local mode remains suitable only for a trusted loopback user.
OMNIFETCH_PUBLIC_MODE=false
OMNIFETCH_ALLOW_GENERIC_EXTRACTOR=false

# Optional self-hosted authenticated mode. Set the host path to a Netscape
# cookies file, then explicitly enable the feature. The file is bind-mounted
# read-only; yt-dlp receives a short-lived private copy for each operation.
OMNIFETCH_ENABLE_AUTHENTICATED_MEDIA=false
OMNIFETCH_COOKIE_FILE_HOST=./secrets/disabled.cookies.txt
OMNIFETCH_ALLOWED_PORTS=80,443
OMNIFETCH_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Compose sets this to the writable data volume. Override only for a direct
# host installation.
OMNIFETCH_DOWNLOAD_DIR=/data/downloads
OMNIFETCH_FRONTEND_DIR=/app/frontend

# Optional explicit FFmpeg executable or directory. Empty uses PATH.
OMNIFETCH_FFMPEG_LOCATION=
